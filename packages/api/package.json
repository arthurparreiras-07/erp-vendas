{
  "name": "erp-vendas-api",
  "version": "1.0.0",
  "description": "ERP Gestão de Vendas — Backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migration:create": "tsx node_modules/.bin/mikro-orm migration:create",
    "migration:up": "tsx node_modules/.bin/mikro-orm migration:up",
    "seed": "tsx src/shared/infra/seed.ts"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@fastify/cors": "^8.1.1",
    "@mikro-orm/core": "^6.3.13",
    "@mikro-orm/postgresql": "^6.3.13",
    "@mikro-orm/migrations": "^6.3.13",
    "@mikro-orm/reflection": "^6.3.13",
    "@mikro-orm/cli": "^6.3.13",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.15.7",
    "ts-node": "^10.9.2",
    "@types/node": "^20.14.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0"
  },
  "mikro-orm": {
    "configPaths": ["./mikro-orm.config.ts"]
  }
}
