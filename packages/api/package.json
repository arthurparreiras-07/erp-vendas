{
  "name": "erp-vendas-api",
  "version": "1.0.0",
  "description": "ERP Gestão de Vendas — Backend",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/src/app.js",
    "migration:create": "tsx node_modules/.bin/mikro-orm migration:create",
    "migration:up": "tsx node_modules/.bin/mikro-orm migration:up",
    "seed": "tsx src/shared/infra/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.1.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@mikro-orm/cli": "^6.3.13",
    "@mikro-orm/core": "^6.3.13",
    "@mikro-orm/migrations": "^6.3.13",
    "@mikro-orm/postgresql": "^6.3.13",
    "@mikro-orm/reflection": "^6.3.13",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "fastify": "^4.28.1",
    "fastify-metrics": "^10.6.0",
    "fastify-plugin": "^4.5.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.7"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  }
}
